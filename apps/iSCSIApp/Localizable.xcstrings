    "Some devices require credentials before they will list their targets. Leave these empty if yours does not.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos dispositivos piden credenciales antes de mostrar sus destinos. Déjalos vacíos si el tuyo no las pide."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分设备需要验证身份后才会列出目标。如果设备没有此要求，请留空。"
          }
        }
      }
    },
    "Some things could not be removed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas cosas no se pudieron eliminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分内容未能移除。"
          }
        }
      }
    },
    "Still attached: %@. Quitting would install the update under it. Detach it — in each account that has one — and quit again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue conectado: %@. Si sales, la actualización se instalaría mientras está en uso. Desconéctalo —en cada cuenta que tenga uno— y vuelve a salir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有连接：%1$@。退出会在其仍然连接时安装更新。请在所有连接了卷的账户中断开连接，然后再次退出。"
          }
        }
      }
    },
    "Still trying to attach after 5 minutes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue intentando conectar tras 5 minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已重试挂载 5 分钟，仍未成功。"
          }
        }
      }
    },
    "Stopped: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止：%1$@"
          }
        }
      }
    },
