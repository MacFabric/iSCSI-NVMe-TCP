            "state": "translated",
            "value": "CHAP 密钥"
          }
        }
      }
    },
    "CHAP user": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuario CHAP"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CHAP 用户名"
          }
        }
      }
    },
    "Cached writes will be committed every %lld seconds and when the volume is detached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las escrituras en caché se consolidarán cada %lld segundos y al desconectar el volumen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔 %1$lld 秒及断开时提交缓存中的写入。"
          }
        }
      }
    },
    "Cached writes will be committed every second and when the volume is detached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las escrituras en caché se consolidarán cada segundo y al desconectar el volumen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每秒及断开时提交缓存中的写入。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Capacity": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capacidad"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容量"
          }
        }
      }
    },
    "Changing the login item": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el elemento de inicio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更改登录项"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar actualizaciones…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        }
      }
    },
    "Check that the background service is running and the filesystem extension is enabled, on the Setup screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pantalla Configuración inicial, verifica que el servicio en segundo plano esté en ejecución y que la extensión del sistema de archivos esté activada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请前往“初始设置”，确认后台服务正在运行，文件系统扩展已启用。"
          }
        }
      }
    },
    "Check the CHAP username and secret, the initiator IQN or host NQN, and the target's access rules. The original response below identifies the specific refusal.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el usuario y el secreto CHAP, el IQN del iniciador o el NQN del host, y las reglas de acceso del destino. La respuesta original de abajo indica el motivo concreto del rechazo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 CHAP 用户名和密钥、发起端 IQN 或主机 NQN，以及目标的访问规则。下方原始响应提供了具体拒绝原因。"
          }
        }
      }
    },
    "Check the address, port and network interface, and confirm the storage device is online.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la dirección, el puerto y la interfaz de red, y confirma que el dispositivo de almacenamiento esté en línea."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查地址、端口及网络接口，并确认存储设备在线。"
          }
        }
      }
    },
    "Check the network and storage device, then reconnect.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la red y el dispositivo de almacenamiento, y vuelve a conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络和存储设备，再重新连接。"
          }
        }
      }
    },
    "Check the target's protocol settings. Keep the original diagnostic below when reporting this issue.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la configuración de protocolo del destino. Conserva el diagnóstico original de abajo si informas de este problema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查目标的协议设置。反馈问题时，请保留下方原始诊断信息。"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择"
          }
        }
      }
    },
    "Clean up": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpiar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理注册信息"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Close anything using the volume — including Finder windows and Terminal sessions inside it — and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra todo lo que use el volumen —incluidas las ventanas del Finder y las sesiones de Terminal dentro de él— e intenta de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请关闭正在使用此卷的应用，包括打开此卷的 Finder 窗口和终端会话，然后重试。"
          }
        }
      }
    },
    "Commit writes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consolidar escrituras"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交写入"
          }
        }
      }
    },
    "Connected — attached in another account, or still connecting — so the address, port, name and %@ can't change.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado —en otra cuenta, o aún conectándose—, así que la dirección, el puerto, el nombre y el %@ no pueden cambiar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标已连接，可能正由另一账户挂载或仍在建立连接，因此无法更改地址、端口、名称和%1$@。"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "Continue?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Continuar?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续？"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        }
      }
    },
    "Could not attach at login — %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se conectó al iniciar sesión — %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时未能挂载：%1$@"
          }
        }
      }
    },
    "Could not attach the LUN as a disk: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar el LUN como disco: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将 LUN 挂载为磁盘：%1$@"
          }
        }
      }
    },
    "Could not attach “%@” at login": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar “%@” al iniciar sesión"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时未能挂载“%1$@”"
          }
        }
      }
    },
    "Could not connect to the storage target.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el destino de almacenamiento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接存储目标。"
          }
        }
      }
    },
    "Could not serve the LUN as a file, even after removing %lld stale copy(s) of the filesystem extension. Details: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo servir el LUN como archivo, ni siquiera tras eliminar %lld copia(s) obsoleta(s) de la extensión del sistema de archivos. Detalles: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已清理 %1$lld 个失效的文件系统扩展副本，仍无法将 LUN 提供为文件。详情：%2$@"
          }
        }
      }
    },
    "Could not serve the LUN as a file: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo servir el LUN como archivo: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将 LUN 提供为文件：%1$@"
          }
        }
      }
    },
    "Daemon (SMAppService)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Daemon (SMAppService)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台服务（SMAppService）"
          }
        }
      }
    },
    "Delete saved targets and passwords": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar destinos y contraseñas guardados"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除已保存的目标和密码"
          }
        }
      }
    },
    "Delete the folder in Finder once the app has quit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la carpeta en el Finder cuando la app se haya cerrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请退出应用后，在 Finder 中删除文件夹。"
          }
        }
      }
    },
    "Detach": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开"
          }
        }
      }
    },
    "Detach All": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar todo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部断开"
          }
        }
      }
    },
    "Detach again. If the storage device is unreachable, detaching waits for it to answer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a desconectar. Si no se puede acceder al dispositivo de almacenamiento, la desconexión espera a que responda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请再次尝试断开。如果存储设备无法访问，断开操作会等待设备响应。"
          }
        }
      }
    },
    "Detach and Install": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar e instalar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开并安装"
          }
        }
      }
    },
    "Detach and Quit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar y salir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开连接并退出"
          }
        }
      }
    },
    "Detach it under Other Attached Disks, then attach again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconéctalo en Otros discos conectados y vuelve a conectarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“其他已挂载磁盘”中断开此磁盘，再重新挂载。"
          }
        }
      }
    },
    "Detach it, then edit it. Nothing was saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconéctalo y luego edítalo. No se guardó nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先断开挂载，再进行编辑。本次更改未保存。"
          }
        }
      }
    },
    "Detach them — in each account that has one — and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconéctalos —en cada cuenta que tenga alguno— e intenta de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在所有连接了卷的账户中断开连接，然后重试。"
          }
        }
      }
    },
    "Detach to change the address, port, name or %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconecta para cambiar la dirección, el puerto, el nombre o el %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先断开，再更改地址、端口、名称或%1$@。"
          }
        }
      }
    },
    "Detach volumes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar volúmenes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开已挂载的卷"
          }
        }
      }
    },
    "Detaching did not finish: %@ is still attached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La desconexión no terminó: %@ sigue conectado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未完全断开：%1$@ 仍处于挂载状态。"
          }
        }
      }
    },
    "Detaching “%@”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desconectar “%@”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在断开“%1$@”"
          }
        }
      }
    },
    "Device": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备"
          }
        }
      }
    },
    "Diagnostics": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnóstico"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息"
          }
        }
      }
    },
    "Disabled on the target": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivada en el destino"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标端已停用"
          }
        }
      }
    },
    "Discover": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubrir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现设备"
          }
        }
      }
    },
    "Disk Utility shows what is on it. Do not erase it unless you mean to delete what it holds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilidad de Discos muestra lo que contiene. No lo borres a menos que quieras eliminar lo que hay en él."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在“磁盘工具”中查看其中的内容。除非确实要删除其中的数据，否则请勿抹掉它。"
          }
        }
      }
    },
    "Disk, nothing mounted": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disco, nada montado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘，未挂载任何卷"
          }
        }
      }
    },
    "DiskImages2 attach failed: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la conexión con DiskImages2: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskImages2 挂载失败：%1$@"
          }
        }
      }
    },
    "DiskImages2 attach unavailable: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión con DiskImages2 no está disponible: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskImages2 挂载功能不可用：%1$@"
          }
        }
      }
    },
    "DiskImages2 attached nothing for %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskImages2 no conectó nada para %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DiskImages2 未能挂载 %1$@"
          }
        }
      }
    },
    "Don't Quit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No salir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不退出"
          }
        }
      }
    },
    "Durability": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durabilidad"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据持久性"
          }
        }
      }
    },
    "Each write is on stable media before it is acknowledged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada escritura está en un medio estable antes de confirmarse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次写入均在数据落入持久存储后才确认成功。"
          }
        }
      }
    },
    "Edit %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑 %1$@"
          }
        }
      }
    },
    "Edit the target: enter a host name, an IPv4 address or an IPv6 address, without brackets, and put the port in the Port field.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita el destino: escribe un nombre de host, una dirección IPv4 o una dirección IPv6, sin corchetes, y pon el puerto en el campo Puerto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请编辑目标：填写主机名、IPv4 地址或不带方括号的 IPv6 地址，并将端口填入“端口”栏。"
          }
        }
      }
    },
    "Edit “%@”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar “%@”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑“%1$@”"
          }
        }
      }
    },
    "Edit…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑…"
          }
        }
      }
    },
    "Eject": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expulsar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推出"
          }
        }
      }
    },
    "Eject and Detach": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expulsar y desconectar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推出并断开"
          }
        }
      }
    },
    "Eject “%@”?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Expulsar “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推出“%1$@”？"
          }
        }
      }
    },
    "Enable": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用"
          }
        }
      }
    },
    "Enable at Next Restart": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar al reiniciar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次重启时启用"
          }
        }
      }
    },
    "Enable the filesystem extension?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Activar la extensión del sistema de archivos?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用文件系统扩展？"
          }
        }
      }
    },
    "Enabled on the target": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activada en el destino"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标端已启用"
          }
        }
      }
    },
    "Engine": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎"
          }
        }
      }
    },
    "Enter the CHAP secret first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe primero el secreto CHAP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先输入 CHAP 密钥。"
          }
        }
      }
    },
    "Enter the secret too, or clear the user — a name on its own does not verify anything.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe también el secreto o borra el usuario: un nombre por sí solo no verifica nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请同时输入密钥，或清空用户名。仅填写用户名无法验证身份。"
          }
        }
      }
    },
    "Every %lld seconds": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada %lld segundos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔 %1$lld 秒"
          }
        }
      }
    },
    "Every second": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada segundo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每秒"
          }
        }
      }
    },
    "Everything has been removed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó todo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容已移除。"
          }
        }
      }
    },
    "FSKit module (Backend A)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Módulo FSKit (Backend A)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FSKit 模块（后端 A）"
          }
        }
      }
    },
    "Fail the connection": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No conectar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中止连接"
          }
        }
      }
    },
    "Falls back to whatever macOS picks when this interface is missing or has no route, and tries it again at the next reconnect.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la que elija macOS cuando esta interfaz no existe o no tiene ruta, y vuelve a probarla en la siguiente reconexión."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选接口不存在或没有可用路由时，改用 macOS 选择的接口；下次重连时会再次尝试原接口。"
          }
        }
      }
    },
    "Filesystem extension enabled": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensión del sistema de archivos activada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件系统扩展已启用"
          }
        }
      }
    },
    "Filesystem extension registered": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensión del sistema de archivos registrada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件系统扩展已注册"
          }
        }
      }
    },
    "Find": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找"
          }
        }
      }
    },
    "Finish setting up": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la configuración inicial"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成初始设置"
          }
        }
      }
    },
    "Finish setup before adding targets": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la configuración inicial antes de agregar destinos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成初始设置，再添加目标"
          }
        }
      }
    },
    "Finish setup first — the background service and filesystem extension have to be running before a target can be attached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina primero la configuración inicial: el servicio en segundo plano y la extensión del sistema de archivos tienen que estar en ejecución para poder conectar un destino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成初始设置。后台服务和文件系统扩展运行后，才能挂载存储目标。"
          }
        }
      }
    },
    "Force Eject": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar expulsión"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制推出"
          }
        }
      }
    },
    "Give up per-write durability?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Renunciar a la durabilidad en cada escritura?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭每次写入的持久性保障？"
          }
        }
      }
    },
    "In use by another session on this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra cuenta de esta Mac lo está usando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上的另一个账户正在使用此磁盘。"
          }
        }
      }
    },
    "Install": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装"
          }
        }
      }
    },
    "Installed in Applications": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalada en Aplicaciones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已放入“应用程序”"
          }
        }
      }
    },
    "Installing now would replace the filesystem extension that %@ is using, and anything writing to it at that moment would lose the process answering its reads and writes.\n\nThe update is downloaded and ready. It will install itself and relaunch the app as soon as the last volume is detached. Quitting the app installs it too, so a quit asks you to detach first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar ahora sustituiría la extensión del sistema de archivos que está usando %@, y lo que esté escribiendo en él en ese momento perdería el proceso que atiende sus lecturas y escrituras.\n\nLa actualización está descargada y lista. Se instalará sola y volverá a abrir la app en cuanto se desconecte el último volumen. Salir de la app también la instala, así que al salir se te pedirá que desconectes primero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在安装会替换%1$@正在使用的文件系统扩展，正在写入该卷的程序会失去负责处理读写的进程。\n\n更新已下载就绪。断开最后一个卷后，将自动安装更新并重新启动应用。退出应用也会安装更新，因此退出前会要求先断开连接。"
          }
        }
      }
    },
    "Interface": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfaz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接口"
          }
        }
      }
    },
    "It is on macOS's list of enabled extensions, and turns on the next time the system service that reads the list restarts — at the latest when this Mac restarts. Turning it on now would restart that service and disconnect what is mounted through it, in every account: %@. To turn it on without restarting the Mac, detach those, then choose Re-check.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está en la lista de extensiones activadas de macOS y se activará la próxima vez que se reinicie el servicio del sistema que lee la lista; a más tardar, cuando se reinicie esta Mac. Activarla ahora reiniciaría ese servicio y desconectaría lo que está montado a través de él, en todas las cuentas: %@. Para activarla sin reiniciar la Mac, desconecta esos volúmenes y elige Volver a verificar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此扩展已加入 macOS 的启用列表，将在相关系统服务下次启动时生效；重新启动 Mac 即可完成。立即重启服务会断开所有账户通过它挂载的卷：%1$@。如需立即启用，请先断开这些卷，再点击“重新检查”。"
          }
        }
      }
    },
    "It is on macOS's list, but the system service that reads the list could not be restarted: %@. Choose Enable to try again, or restart this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está en la lista de macOS, pero no se pudo reiniciar el servicio del sistema que la lee: %@. Elige Activar para intentar de nuevo, o reinicia esta Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此扩展已加入 macOS 的启用列表，但相关系统服务无法重启：%1$@。请点击“启用”重试，或重新启动 Mac。"
          }
        }
      }
    },
    "It may still be starting up. Try again shortly.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que aún se esté iniciando. Intenta de nuevo en unos momentos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备可能仍在启动，请稍后重试。"
          }
        }
      }
    },
    "It will appear by itself if the target answers. Otherwise check the target and press Attach.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecerá solo si el destino responde. Si no, revisa el destino y haz clic en Conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标恢复响应后会自动挂载。也可以检查目标设备，再点击“挂载”。"
          }
        }
      }
    },
    "Its address, port, name or %@ can't change while it is attached: the app finds the mounted volume by them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su dirección, puerto, nombre o %@ no pueden cambiar mientras está conectado: la app encuentra el volumen montado a partir de ellos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂载期间无法更改地址、端口、名称或%1$@，应用需要依靠这些信息定位已挂载的卷。"
          }
        }
      }
    },
    "Its settings and saved CHAP secret are removed from this Mac. Nothing on the target changes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su configuración y el secreto CHAP guardado se eliminan de esta Mac. No cambia nada en el destino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除此 Mac 保存的目标设置和 CHAP 密钥，不会更改目标设备。"
          }
        }
      }
    },
    "Its settings are removed from this Mac. Nothing on the target changes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su configuración se elimina de esta Mac. No cambia nada en el destino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除此 Mac 保存的目标设置，不会更改目标设备。"
          }
        }
      }
    },
    "Its volume is still mounted and will be ejected first; anything still using files on it — a running virtual machine, an open document — should be shut down before continuing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su volumen sigue montado y se expulsará primero; lo que todavía use archivos en él —una máquina virtual en ejecución, un documento abierto— debe cerrarse antes de continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卷仍处于挂载状态，移除前会先推出。请先关闭正在使用其中的文件的应用，例如虚拟机或打开的文档。"
          }
        }
      }
    },
    "Its volume is still mounted. Detaching will eject the volume first; anything still using files on it — a running virtual machine, an open document — should be shut down before continuing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su volumen sigue montado. Al desconectar se expulsará primero el volumen; lo que todavía use archivos en él —una máquina virtual en ejecución, un documento abierto— debe cerrarse antes de continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卷仍处于挂载状态，断开时将先推出卷。请先关闭正在使用其中的文件的应用，例如虚拟机或打开的文档。"
          }
        }
      }
    },
    "Its volumes mount in Finder. Takes effect the next time it is attached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus volúmenes se montan en el Finder. Se aplica la próxima vez que se conecte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其卷会在 Finder 中挂载。下次挂载时生效。"
          }
        }
      }
    },
    "Keep the original diagnostic below and report this issue.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva el diagnóstico original de abajo e informa de este problema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保留下方原始诊断信息并反馈此问题。"
          }
        }
      }
    },
    "Kept on this Mac's disk, encrypted, only while the target is attached. Takes effect the next time it is attached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en el disco de esta Mac, cifrada, solo mientras el destino está conectado. Se aplica la próxima vez que se conecte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在目标挂载期间保存在此 Mac 的磁盘上，并加密存储。下次挂载时生效。"
          }
        }
      }
    },
    "LUN": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LUN"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LUN"
          }
        }
      }
    },
    "LUNs": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LUN"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LUN"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más tarde"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后"
          }
        }
      }
    },
    "Loading targets…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando destinos…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载存储目标…"
          }
        }
      }
    },
    "Local cache": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché local"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地缓存"
          }
        }
      }
    },
    "Mounted at": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Montado en"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂载位置"
          }
        }
      }
    },
    "Move App to Trash": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover la app a la Papelera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将应用移到废纸篓"
          }
        }
      }
    },
    "Mutual CHAP secret": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Secreto CHAP mutuo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双向 CHAP 密钥"
          }
        }
      }
    },
    "Mutual CHAP user": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuario CHAP mutuo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双向 CHAP 用户名"
          }
        }
      }
    },
    "NVMe/TCP": {
      "shouldTranslate": false
    },
    "NVMe/TCP subsystems list themselves to any host that can reach the port. Whether this Mac may attach is decided per subsystem by its host NQN, shown when you edit the target.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subsistemas NVMe/TCP se anuncian a cualquier host que pueda llegar al puerto. Si esta Mac puede conectarse lo decide cada subsistema según su NQN de host, que se muestra al editar el destino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何能访问端口的主机都能发现 NVMe/TCP 子系统。此 Mac 是否有权连接，由各子系统根据主机 NQN 决定；可在编辑目标时查看该标识。"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "Namespace": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio de nombres"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命名空间"
          }
        }
      }
    },
    "Namespace ID": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ID de espacio de nombres"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命名空间 ID"
          }
        }
      }
    },
    "Negotiated": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parámetros negociados"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协商参数"
          }
        }
      }
    },
    "Network": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络"
          }
        }
      }
    },
    "Network interface": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfaz de red"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络接口"
          }
        }
      }
    },
    "Never uses another interface — not Wi-Fi, not a VPN. If this one is unavailable, the connection fails.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca usa otra interfaz: ni Wi-Fi ni VPN. Si esta no está disponible, la conexión falla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终只使用所选接口，不切换到 Wi-Fi 或 VPN 等其他接口；此接口不可用时连接失败。"
          }
        }
      }
    },
    "Never — target cache is non-volatile": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca — caché no volátil"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不主动刷新（目标缓存须具备掉电保护）"
          }
        }
      }
    },
    "No %@ targets": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay destinos %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无 %1$@ 目标"
          }
        }
      }
    },
    "No Active Sessions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay sesiones activas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有活动连接"
          }
        }
      }
    },
    "No Targets": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay destinos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无存储目标"
          }
        }
      }
    },
    "No Targets Offered": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ofrece ningún destino"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发现可用目标"
          }
        }
      }
    },
    "No flushes will be sent while attached — only when the volume is detached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se enviarán vaciados de caché mientras esté conectado; solo al desconectar el volumen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂载期间不会发送缓存刷新请求，仅在断开时刷新。"
          }
        }
      }
    },
    "No targets yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay destinos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未添加存储目标"
          }
        }
      }
    },
    "Not attached as a disk": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No conectado como disco"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未作为磁盘挂载"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不"
          }
        }
      }
    },
    "Not reported": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No informado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提供"
          }
        }
      }
    },
    "Nothing on the disk is mounted on this Mac. It appears only as /dev/rdiskN, for a virtual machine or another app that uses the whole disk. A flush sent to the device does not reach the target, so Commit writes above is what keeps its writes safe. Takes effect the next time it is attached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta Mac no se monta nada del disco. Solo aparece como /dev/rdiskN, para una máquina virtual u otra app que use el disco completo. Un vaciado de caché enviado al dispositivo no llega al destino, así que lo que protege sus escrituras es Consolidar escrituras, más arriba. Se aplica la próxima vez que se conecte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 不会挂载磁盘上的任何内容。它只以 /dev/rdiskN 的形式出现，供虚拟机或使用整个磁盘的其他应用使用。发送到该设备的缓存刷新请求不会到达目标，因此写入安全取决于上方的“提交写入”设置。下次挂载时生效。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "On (FUA on every write)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activada (FUA en cada escritura)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用（每次写入均使用 FUA）"
          }
        }
      }
    },
    "On every write — safest": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cada escritura — lo más seguro"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次写入时提交（最安全）"
          }
        }
      }
    },
    "On this Mac": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Mac 上"
          }
        }
      }
    },
    "Only this copy registered": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo esta copia registrada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当前副本已注册"
          }
        }
      }
    },
    "Open Disk Utility, select it, and erase it as APFS or ExFAT. It will mount by itself afterwards.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Utilidad de Discos, selecciónalo y bórralo como APFS o ExFAT. Después se montará solo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开“磁盘工具”，选中该磁盘并抹掉为 APFS 或 ExFAT 格式。完成后会自动挂载。"
          }
        }
      }
    },
    "Open Login Items…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Elementos de inicio…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开登录项…"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Configuración del Sistema"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "Open the Setup screen to see what is missing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la pantalla Configuración inicial para ver qué falta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开“初始设置”，查看尚未完成的项目。"
          }
        }
      }
    },
    "Optional. Adds a link in /usr/local/bin so iscsictl runs from any Terminal, for every account on this Mac. macOS asks for an administrator's password.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Agrega un enlace en /usr/local/bin para que iscsictl funcione desde cualquier Terminal, en todas las cuentas de esta Mac. macOS pide la contraseña de un administrador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：在 /usr/local/bin 中添加命令链接，供这台 Mac 上的所有账户在任意终端运行 iscsictl。macOS 会要求输入管理员密码。"
          }
        }
      }
    },
    "Optional. Proves the target is who it claims to be.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Demuestra que el destino es quien dice ser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选，用于确认连接的是可信目标。"
          }
        }
      }
    },
    "Original diagnostic:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnóstico original:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始诊断信息："
          }
        }
      }
    },
    "Other Attached Disks": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros discos conectados"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他已挂载磁盘"
          }
        }
      }
    },
    "Photos archive": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo de fotos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片归档"
          }
        }
      }
    },
    "Port": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puerto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口"
          }
        }
      }
    },
    "Portal": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Portal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接地址"
          }
        }
      }
    },
    "Protocol": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocolo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协议"
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出"
          }
        }
      }
    },
    "Quit the apps using files on it — Finder windows and Terminal sessions inside it count — and detach again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra las apps que usan archivos en él —también cuentan las ventanas del Finder y las sesiones de Terminal abiertas dentro de él— y vuelve a desconectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请退出正在使用此卷中文件的应用，再尝试断开。打开此卷的 Finder 窗口和终端会话也会占用它。"
          }
        }
      }
    },
    "Quitting now installs version %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sales ahora, se instala la versión %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在退出将安装版本 %1$@"
          }
        }
      }
    },
    "Raw device, nothing mounted": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo sin procesar, nada montado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始设备，未挂载任何卷"
          }
        }
      }
    },
    "Re-check": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a verificar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        }
      }
    },
    "Re-register": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a registrar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新注册"
          }
        }
      }
    },
    "Reading your targets": {
      "localizations": {
