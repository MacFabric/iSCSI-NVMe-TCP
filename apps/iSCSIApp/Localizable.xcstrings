    },
    "Authentication (optional)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticación (opcional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份验证（选填）"
          }
        }
      }
    },
    "Automatic (macOS chooses)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automática (elige macOS)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动（由 macOS 选择）"
          }
        }
      }
    },
    "Background service installed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicio en segundo plano instalado"
          }
        },
        "zh-Hans": {
