    "macOS %@ has a bug that leaves the File System Extensions switch stuck off for third-party extensions, so it has to be enabled another way.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@ tiene un error que deja bloqueado en desactivado el interruptor de Extensiones del sistema de archivos para las extensiones de terceros, así que hay que activarla de otra forma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
