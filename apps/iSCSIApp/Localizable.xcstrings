    },
    "this copy of the app is incomplete — its background service is missing. Reinstall from the disk image.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "esta copia de la app está incompleta: le falta el servicio en segundo plano. Reinstálala desde la imagen de disco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前应用缺少后台服务，文件不完整。请从磁盘映像重新安装。"
          }
        }
      }
    },
    "umount did not run": {
      "localizations": {
