        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloques"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "块数量"
          }
        }
      }
    },
    "CHAP secret": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Secreto CHAP"
          }
        },
        "zh-Hans": {
