      }
    },
    "⚠ If the target loses power, this volume can be corrupted. Takes effect the next time this target is attached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Si el destino se queda sin alimentación, este volumen puede dañarse. Se aplica la próxima vez que se conecte este destino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ 目标设备断电可能导致此卷损坏。下次挂载此目标时生效。"
          }
