            "state": "translated",
            "value": "后台服务已安装"
          }
        }
      }
    },
    "Block size": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño de bloque"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "块大小"
          }
        }
      }
    },
    "Blocks": {
